rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User private profile document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // User financial plans & scenarios subcollection
      match /plans/{planId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
