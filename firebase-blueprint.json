{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "entities": {
    "UserProfile": {
      "collection": "users",
      "fields": {
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "User display name" },
        "photoURL": { "type": "string", "description": "User profile photo URL" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" }
      }
    },
    "FinancialPlan": {
      "collection": "users/{userId}/plans",
      "fields": {
        "household": { "type": "object", "description": "Household demographic and income profile" },
        "cashFlow": { "type": "object", "description": "Monthly cash flow and budget" },
        "debts": { "type": "array", "description": "Debt liabilities list" },
        "debtMethod": { "type": "string", "description": "Debt payoff strategy" },
        "releasedAction": { "type": "string", "description": "Action for released cash flow" },
        "releasedReinvestPercent": { "type": "number", "description": "Percentage to reinvest" },
        "extraMonthlyBudget": { "type": "number", "description": "Extra monthly debt budget" },
        "assets": { "type": "array", "description": "Investment accounts and holdings" },
        "retirement": { "type": "object", "description": "Retirement lifestyle parameters" },
        "education": { "type": "array", "description": "Education funding goals" },
        "protection": { "type": "object", "description": "Life insurance protection analysis" },
        "risk": { "type": "object", "description": "Risk profile questionnaire" },
        "savedScenarios": { "type": "array", "description": "Saved scenario comparisons" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last cloud sync" }
      }
    }
  }
}
